                "created": "{{ bhtYear2 }}-{{ bhtMonth2 }}-{{ bhtDay2 }}",
                    {% endif -%}
                {% endif -%}
                {% if umoNM1 -%}
                "insurer": {
                    "reference": "Organization/{{ umoOrgId }}"
                },
                {% endif -%}
                "request": {
                    "reference": "Claim/{{ claimId }}"
                },
                {% comment %}
                  HCR01: Action Code
                    A1 = Certified in Total
                    A2 = Certified - Partial
                    A3 = Not Certified
                    A4 = Pended
                    A6 = Modified
                    CT = Contact Payer
                    NA = No Action Required
                {% endcomment -%}
                {% assign actionCode = hcrSegment.Elements[1].Value -%}
                {% if actionCode == "A1" -%}
                "outcome": "complete",
                "disposition": "Certified in Total",
                {% elsif actionCode == "A2" -%}
                "outcome": "partial",
                "disposition": "Certified - Partial",
                {% elsif actionCode == "A3" -%}
                "outcome": "error",
                "disposition": "Not Certified",
                {% elsif actionCode == "A4" -%}
                "outcome": "queued",
                "disposition": "Pended",
                {% elsif actionCode == "A6" -%}
                "outcome": "partial",
                "disposition": "Modified",
                {% elsif actionCode == "CT" -%}
                "outcome": "queued",
                "disposition": "Contact Payer",
                {% elsif actionCode == "NA" -%}
                "outcome": "complete",
                "disposition": "No Action Required",
                {% else -%}
                "outcome": "queued",
                "disposition": "{{ actionCode }}",
                {% endif -%}
                {% comment %} HCR02: Reference Identification (review/certification number) {% endcomment -%}
                {% if hcrSegment.Elements[2].Value != "" -%}
                "preAuthRef": "{{ hcrSegment.Elements[2].Value }}",
                {% endif -%}
                {% comment %} HCR03: Second/Third reasons if present {% endcomment -%}
                "extension": [
                    {
                        "url": "https://x12.org/fhir/StructureDefinition/hcr-action-code",
                        "valueString": "{{ actionCode }}"
                    }
                    {% if hcrSegment.Elements[3].Value != "" -%}
                    ,{
                        "url": "https://x12.org/fhir/StructureDefinition/hcr-reject-reason",
                        "valueString": "{{ hcrSegment.Elements[3].Value }}"
                    }
                    {% endif -%}
                ],
                {% comment %} ClaimResponse items {% endcomment -%}
                {% if sv1Segment or sv2Segment -%}
                "item": [
                    {
                        "itemSequence": 1,
                        "adjudication": [
                            {
                                "category": {
                                    "coding": [
                                        {
                                            "system": "http://terminology.hl7.org/CodeSystem/adjudication",
                                            "code": "submitted"
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                ],
                {% endif -%}
                {% if subscriberNM1 -%}
                "insurance": [
                    {
                        "sequence": 1,
                        "focal": true,
                        "coverage": {
                            "reference": "Coverage/{{ coverageId }}"
                        }
                    }
                ],
                {% endif -%}
                {% comment %} Period from certification dates {% endcomment -%}
                {% if certEffDateDTP or certExpDateDTP -%}
                "preAuthPeriod": {
                    {% if certEffDateDTP -%}
                        {% assign cEffVal = certEffDateDTP.Elements[3].Value -%}
                        {% assign cEffYear = cEffVal | slice: 0, 4 -%}
                        {% assign cEffMonth = cEffVal | slice: 4, 2 -%}
                        {% assign cEffDay = cEffVal | slice: 6, 2 -%}
                    "start": "{{ cEffYear }}-{{ cEffMonth }}-{{ cEffDay }}"
                    {% endif -%}
                    {% if certExpDateDTP -%}
                        {% assign cExpVal = certExpDateDTP.Elements[3].Value -%}
                        {% assign cExpYear = cExpVal | slice: 0, 4 -%}
                        {% assign cExpMonth = cExpVal | slice: 4, 2 -%}
                        {% assign cExpDay = cExpVal | slice: 6, 2 -%}
                        {% if certEffDateDTP -%}
                    ,"end": "{{ cExpYear }}-{{ cExpMonth }}-{{ cExpDay }}"
                        {% else -%}
                    "end": "{{ cExpYear }}-{{ cExpMonth }}-{{ cExpDay }}"
                        {% endif -%}
                    {% endif -%}
                }
                {% endif -%}
            },
            "request": {
                "method": "PUT",
                "url": "ClaimResponse/{{ claimResponseId }}"
            }
        }
        {% endif -%}
    ]
}