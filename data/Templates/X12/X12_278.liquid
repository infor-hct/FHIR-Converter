                            "system": "http://hl7.org/fhir/sid/icd-10-cm",
                            {% elsif diagQualifier == "BK" or diagQualifier == "BF" or diagQualifier == "BJ" -%}
                            "system": "http://hl7.org/fhir/sid/icd-9-cm",
                            {% else -%}
                            "system": "http://hl7.org/fhir/sid/icd-10-cm",
                            {% endif -%}
                            "code": "{{ diagCode }}"
                        }
