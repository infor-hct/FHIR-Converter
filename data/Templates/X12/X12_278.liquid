                            }
                        ],
                        "text": "Principal Diagnosis"
                    }
                ],
                {% endif -%}
                "subject": {
                    "reference": "Patient/{{ patientId }}"
                }
            },
            "request": {
                "method": "PUT",
                "url": "Condition/{{ conditionId }}"
            }
        },
                    {% endif -%}
                {% endif -%}
            {% endfor -%}
