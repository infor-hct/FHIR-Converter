{% comment %}
  X12 278 Health Care Services Review - Prior Authorization
  Converts X12 278 to FHIR R4 Bundle containing:
    - Claim (use=preauthorization)
    - ClaimResponse (if HCR segment present)
    - Patient
    - Organization (UMO, requester)
    - Practitioner (requester, service provider)
    - Coverage
    - Condition (from HI diagnosis codes)
    - ServiceRequest (from SV1/SV2)
{% endcomment -%}
{% assign hlLoops = x12Data | split_x12_by_hl_loop -%}
{% assign headerSegments = x12Data | get_first_x12_segments: 'ISA|GS|ST|BHT' -%}
{% assign allNM1 = x12Data | get_x12_segments_by_type: 'NM1' -%}
{% assign allHL = x12Data | get_x12_segments_by_type: 'HL' -%}
{% assign allREF = x12Data | get_x12_segments_by_type: 'REF' -%}
{% assign allDTP = x12Data | get_x12_segments_by_type: 'DTP' -%}
{% assign allUM = x12Data | get_x12_segments_by_type: 'UM' -%}
{% assign allHCR = x12Data | get_x12_segments_by_type: 'HCR' -%}
{% assign allSV1 = x12Data | get_x12_segments_by_type: 'SV1' -%}
{% assign allSV2 = x12Data | get_x12_segments_by_type: 'SV2' -%}
{% assign allHI = x12Data | get_x12_segments_by_type: 'HI' -%}
{% assign allCL1 = x12Data | get_x12_segments_by_type: 'CL1' -%}
{% assign segLists = x12Data | get_x12_segment_lists: 'NM1|HL|REF|DTP|UM|HCR|SV1|SV2|HI|CL1|CR1|CR2|CR3|CR4|CR5|CR6' -%}
{% comment %} Identify HL loops by level code (HL03) {% endcomment -%}
{% comment %}
  HL03 codes for 278:
    1  = Information Source (Utilization Management Organization)
    2  = Information Receiver (Requester)
    22 = Subscriber
    23 = Dependent
    SS = Service (Patient Event)
    EV = Patient Event (alternate)
{% endcomment -%}
{% comment %} Walk the HL loops to find entities {% endcomment -%}
{% assign umoNM1 = null -%}
{% assign requesterNM1 = null -%}
{% assign subscriberNM1 = null -%}
{% assign dependentNM1 = null -%}
{% assign serviceProviderNM1 = null -%}
{% assign umSegment = null -%}
{% assign hcrSegment = null -%}
{% assign sv1Segment = null -%}
{% assign sv2Segment = null -%}
{% assign subscriberHL = null -%}
{% assign dependentHL = null -%}
{% assign serviceHL = null -%}
{% assign umoHL = null -%}
{% assign requesterHL = null -%}
{% for loop in hlLoops -%}
    {% assign loopFirstSegs = loop | get_first_x12_segments: 'HL|NM1|UM|HCR|SV1|SV2|HI|DTP|REF|CL1|CR1' -%}
    {% if loopFirstSegs.HL -%}
        {% assign hlLevelCode = loopFirstSegs.HL.Elements[3].Value -%}
        {% if hlLevelCode == "20" or hlLevelCode == "1" -%}
            {% assign umoHL = loopFirstSegs.HL -%}
            {% if loopFirstSegs.NM1 -%}
                {% assign umoNM1 = loopFirstSegs.NM1 -%}
            {% endif -%}
        {% endif -%}
        {% if hlLevelCode == "21" or hlLevelCode == "2" -%}
            {% assign requesterHL = loopFirstSegs.HL -%}
            {% if loopFirstSegs.NM1 -%}
                {% assign requesterNM1 = loopFirstSegs.NM1 -%}
            {% endif -%}
        {% endif -%}
        {% if hlLevelCode == "22" -%}
            {% assign subscriberHL = loopFirstSegs.HL -%}
            {% if loopFirstSegs.NM1 -%}
                {% assign subscriberNM1 = loopFirstSegs.NM1 -%}
            {% endif -%}
        {% endif -%}
        {% if hlLevelCode == "23" -%}
            {% assign dependentHL = loopFirstSegs.HL -%}
            {% if loopFirstSegs.NM1 -%}
                {% assign dependentNM1 = loopFirstSegs.NM1 -%}
            {% endif -%}
        {% endif -%}
        {% if hlLevelCode == "SS" or hlLevelCode == "EV" -%}
            {% assign serviceHL = loopFirstSegs.HL -%}
            {% if loopFirstSegs.NM1 -%}
                {% assign serviceProviderNM1 = loopFirstSegs.NM1 -%}
            {% endif -%}
            {% if loopFirstSegs.UM -%}
                {% assign umSegment = loopFirstSegs.UM -%}
            {% endif -%}
            {% if loopFirstSegs.HCR -%}
                {% assign hcrSegment = loopFirstSegs.HCR -%}
            {% endif -%}
            {% if loopFirstSegs.SV1 -%}
                {% assign sv1Segment = loopFirstSegs.SV1 -%}
            {% endif -%}
            {% if loopFirstSegs.SV2 -%}
                {% assign sv2Segment = loopFirstSegs.SV2 -%}
            {% endif -%}
        {% endif -%}
    {% endif -%}
{% endfor -%}
{% comment %} If UM was not found in service loop, try globally {% endcomment -%}
{% if umSegment == null -%}
    {% if allUM.size > 0 -%}
        {% assign umSegment = allUM[0] -%}
    {% endif -%}
{% endif -%}
{% if hcrSegment == null -%}
    {% if allHCR.size > 0 -%}
        {% assign hcrSegment = allHCR[0] -%}
    {% endif -%}
{% endif -%}
{% if sv1Segment == null -%}
    {% if allSV1.size > 0 -%}
        {% assign sv1Segment = allSV1[0] -%}
    {% endif -%}
{% endif -%}
{% if sv2Segment == null -%}
    {% if allSV2.size > 0 -%}
        {% assign sv2Segment = allSV2[0] -%}
    {% endif -%}
{% endif -%}
{% comment %} If NM1 not found by HL loop, try by NM1 entity identifier code {% endcomment -%}
{% if umoNM1 == null or requesterNM1 == null or subscriberNM1 == null -%}
    {% for nm1 in allNM1 -%}
        {% assign entityCode = nm1.Elements[1].Value -%}
        {% if entityCode == "X3" or entityCode == "PR" -%}
            {% if umoNM1 == null -%}
                {% assign umoNM1 = nm1 -%}
            {% endif -%}
        {% endif -%}
        {% if entityCode == "SJ" or entityCode == "1P" -%}
            {% if requesterNM1 == null -%}
                {% assign requesterNM1 = nm1 -%}
            {% endif -%}
        {% endif -%}
        {% if entityCode == "IL" -%}
            {% if subscriberNM1 == null -%}
                {% assign subscriberNM1 = nm1 -%}
            {% endif -%}
        {% endif -%}
        {% if entityCode == "QC" -%}
            {% if dependentNM1 == null -%}
                {% assign dependentNM1 = nm1 -%}
            {% endif -%}
        {% endif -%}
        {% if entityCode == "SV" or entityCode == "71" or entityCode == "FA" or entityCode == "1T" -%}
            {% if serviceProviderNM1 == null -%}
                {% assign serviceProviderNM1 = nm1 -%}
            {% endif -%}
        {% endif -%}
    {% endfor -%}
{% endif -%}
{% comment %} Determine patient: dependent if present, else subscriber {% endcomment -%}
{% if dependentNM1 -%}
    {% assign patientNM1 = dependentNM1 -%}
    {% assign isDependent = true -%}
{% else -%}
    {% assign patientNM1 = subscriberNM1 -%}
    {% assign isDependent = false -%}
{% endif -%}
{% comment %} Generate resource IDs {% endcomment -%}
{% assign patientIdInput = "Patient_278" -%}
{% if patientNM1 -%}
    {% assign patientIdInput = patientNM1.Value | prepend: "Patient_278_" -%}
{% endif -%}
{% assign patientId = patientIdInput | generate_uuid -%}
{% assign fullPatientId = patientId | prepend: 'Patient/' -%}
{% assign claimIdInput = "Claim_278" -%}
{% if headerSegments.BHT -%}
    {% assign claimIdInput = headerSegments.BHT.Elements[3].Value | prepend: "Claim_278_" -%}
{% endif -%}
{% assign claimId = claimIdInput | generate_uuid -%}
{% assign coverageIdInput = "Coverage_278" -%}
{% if subscriberNM1 -%}
    {% assign coverageIdInput = subscriberNM1.Value | prepend: "Coverage_278_" -%}
{% endif -%}
{% assign coverageId = coverageIdInput | generate_uuid -%}
{% assign umoOrgIdInput = "Organization_UMO_278" -%}
{% if umoNM1 -%}
    {% assign umoOrgIdInput = umoNM1.Value | prepend: "Organization_UMO_278_" -%}
{% endif -%}
{% assign umoOrgId = umoOrgIdInput | generate_uuid -%}
{% assign requesterOrgIdInput = "Organization_Requester_278" -%}
{% if requesterNM1 -%}
    {% assign requesterOrgIdInput = requesterNM1.Value | prepend: "Organization_Requester_278_" -%}
{% endif -%}
{% assign requesterOrgId = requesterOrgIdInput | generate_uuid -%}
{% assign requesterPractIdInput = "Practitioner_Requester_278" -%}
{% if requesterNM1 -%}
    {% assign requesterPractIdInput = requesterNM1.Value | prepend: "Practitioner_Requester_278_" -%}
{% endif -%}
{% assign requesterPractId = requesterPractIdInput | generate_uuid -%}
{% assign serviceProviderPractIdInput = "Practitioner_ServiceProvider_278" -%}
{% if serviceProviderNM1 -%}
    {% assign serviceProviderPractIdInput = serviceProviderNM1.Value | prepend: "Practitioner_ServiceProvider_278_" -%}
{% endif -%}
{% assign serviceProviderPractId = serviceProviderPractIdInput | generate_uuid -%}
{% assign serviceRequestIdInput = "ServiceRequest_278" -%}
{% if sv1Segment -%}
    {% assign serviceRequestIdInput = sv1Segment.Value | prepend: "ServiceRequest_278_" -%}
{% elsif sv2Segment -%}
    {% assign serviceRequestIdInput = sv2Segment.Value | prepend: "ServiceRequest_278_" -%}
{% endif -%}
{% assign serviceRequestId = serviceRequestIdInput | generate_uuid -%}
{% assign claimResponseIdInput = "ClaimResponse_278" -%}
{% if hcrSegment -%}
    {% assign claimResponseIdInput = hcrSegment.Value | prepend: "ClaimResponse_278_" -%}
{% endif -%}
{% assign claimResponseId = claimResponseIdInput | generate_uuid -%}
{% comment %} Collect REF segments for prior auth number {% endcomment -%}
{% assign priorAuthRef = null -%}
{% for ref in allREF -%}
    {% if ref.Elements[1].Value == "BB" or ref.Elements[1].Value == "NT" -%}
        {% if priorAuthRef == null -%}
            {% assign priorAuthRef = ref -%}
        {% endif -%}
    {% endif -%}
{% endfor -%}
{% comment %} Collect DTP segments {% endcomment -%}
{% assign serviceDateDTP = null -%}
{% assign admissionDateDTP = null -%}
{% assign certEffDateDTP = null -%}
{% assign certExpDateDTP = null -%}
{% for dtp in allDTP -%}
    {% assign dtpQual = dtp.Elements[1].Value -%}
    {% if dtpQual == "472" -%}
        {% if serviceDateDTP == null -%}
            {% assign serviceDateDTP = dtp -%}
        {% endif -%}
    {% endif -%}
    {% if dtpQual == "435" -%}
        {% if admissionDateDTP == null -%}
            {% assign admissionDateDTP = dtp -%}
        {% endif -%}
    {% endif -%}
    {% if dtpQual == "007" -%}
        {% if certEffDateDTP == null -%}
            {% assign certEffDateDTP = dtp -%}
        {% endif -%}
    {% endif -%}
    {% if dtpQual == "036" -%}
        {% if certExpDateDTP == null -%}
            {% assign certExpDateDTP = dtp -%}
        {% endif -%}
    {% endif -%}
{% endfor -%}
{% comment %} Parse date formats: DTP02 is the date/time format qualifier {% endcomment -%}
{% comment %}
  DTP02: D8 = CCYYMMDD, RD8 = CCYYMMDD-CCYYMMDD range
{% endcomment -%}
{
    "resourceType": "Bundle",
    "type": "batch",
    {% if headerSegments.BHT -%}
        {% assign bundleIdInput = headerSegments.BHT.Value | prepend: "Bundle_278_" -%}
        "id": "{{ bundleIdInput | generate_uuid }}",
    {% endif -%}
    {% if headerSegments.GS -%}
        {% if headerSegments.GS.Elements[4].Value != "" -%}
            {% assign gsDate = headerSegments.GS.Elements[4].Value -%}
            {% assign gsYear = gsDate | slice: 0, 4 -%}
            {% assign gsMonth = gsDate | slice: 4, 2 -%}
            {% assign gsDay = gsDate | slice: 6, 2 -%}
            "timestamp": "{{ gsYear }}-{{ gsMonth }}-{{ gsDay }}T00:00:00Z",
        {% endif -%}
    {% endif -%}
    "identifier": {
        {% if headerSegments.ISA -%}
            "value": "{{ headerSegments.ISA.Elements[13].Value }}"
        {% else -%}
            "value": "278-unknown"
        {% endif -%}
    },
    "entry": [
        {% comment %} ============== Patient Resource ============== {% endcomment -%}
        {% if patientNM1 -%}
        {
            "fullUrl": "urn:uuid:{{ patientId }}",
            "resource": {
                "resourceType": "Patient",
                "id": "{{ patientId }}",
                {% comment %} NM1 entity type: 1=Person, 2=Non-person {% endcomment -%}
                {% if patientNM1.Elements[9].Value != "" -%}
                "identifier": [
                    {
                        {% comment %} NM108=MI means Member ID, NM109=value {% endcomment -%}
                        {% if patientNM1.Elements[8].Value == "MI" -%}
                        "type": {
                            "coding": [
                                {
                                    "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                                    "code": "MB",
                                    "display": "Member Number"
                                }
                            ]
                        },
                        {% elsif patientNM1.Elements[8].Value == "II" -%}
                        "type": {
                            "coding": [
                                {
                                    "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                                    "code": "PT",
                                    "display": "Patient external identifier"
                                }
                            ]
                        },
                        {% endif -%}
                        "value": "{{ patientNM1.Elements[9].Value }}"
                    }
                ],
                {% endif -%}
                "name": [
                    {
                        "use": "official",
                        "family": "{{ patientNM1.Elements[3].Value }}",
                        "given": [
                            "{{ patientNM1.Elements[4].Value }}"
                            {% if patientNM1.Elements[5].Value != "" -%}
                            ,"{{ patientNM1.Elements[5].Value }}"
                            {% endif -%}
                        ]
                        {% if patientNM1.Elements[6].Value != "" -%}
                        ,"prefix": [
                            "{{ patientNM1.Elements[6].Value }}"
                        ]
                        {% endif -%}
                        {% if patientNM1.Elements[7].Value != "" -%}
                        ,"suffix": [
                            "{{ patientNM1.Elements[7].Value }}"
                        ]
                        {% endif -%}
                    }
                ]
            },
            "request": {
                "method": "PUT",
                "url": "Patient/{{ patientId }}"
            }
        },
        {% endif -%}
        {% comment %} ============== UMO Organization Resource ============== {% endcomment -%}
        {% if umoNM1 -%}
        {
            "fullUrl": "urn:uuid:{{ umoOrgId }}",
            "resource": {
                "resourceType": "Organization",
                "id": "{{ umoOrgId }}",
                {% if umoNM1.Elements[9].Value != "" -%}
                "identifier": [
                    {
                        {% if umoNM1.Elements[8].Value == "PI" -%}
                        "type": {
                            "coding": [
                                {
                                    "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                                    "code": "PI",
                                    "display": "Payor Identification"
                                }
                            ]
                        },
                        {% elsif umoNM1.Elements[8].Value == "XV" -%}
                        "type": {
                            "coding": [
                                {
                                    "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                                    "code": "NPI"
                                }
                            ]
                        },
                        "system": "http://hl7.org/fhir/sid/us-npi",
                        {% elsif umoNM1.Elements[8].Value == "46" -%}
                        "type": {
                            "coding": [
                                {
                                    "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                                    "code": "NIIP",
                                    "display": "National Insurance Payor Identifier"
                                }
                            ]
                        },
                        {% endif -%}
                        "value": "{{ umoNM1.Elements[9].Value }}"
                    }
                ],
                {% endif -%}
                {% if umoNM1.Elements[2].Value == "2" -%}
                "name": "{{ umoNM1.Elements[3].Value }}"
                {% else -%}
                "name": "{{ umoNM1.Elements[4].Value }} {{ umoNM1.Elements[3].Value }}"
                {% endif -%}
            },
            "request": {
                "method": "PUT",
                "url": "Organization/{{ umoOrgId }}"
            }
        },
        {% endif -%}
        {% comment %} ============== Requester Organization Resource ============== {% endcomment -%}
        {% if requesterNM1 -%}
            {% if requesterNM1.Elements[2].Value == "2" -%}
        {
            "fullUrl": "urn:uuid:{{ requesterOrgId }}",
            "resource": {
                "resourceType": "Organization",
                "id": "{{ requesterOrgId }}",
                {% if requesterNM1.Elements[9].Value != "" -%}
                "identifier": [
                    {
                        {% if requesterNM1.Elements[8].Value == "XV" -%}
                        "type": {
                            "coding": [
                                {
                                    "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                                    "code": "NPI"
                                }
                            ]
                        },
                        "system": "http://hl7.org/fhir/sid/us-npi",
                        {% endif -%}
                        "value": "{{ requesterNM1.Elements[9].Value }}"
                    }
                ],
                {% endif -%}
                "name": "{{ requesterNM1.Elements[3].Value }}"
            },
            "request": {
                "method": "PUT",
                "url": "Organization/{{ requesterOrgId }}"
            }
        },
            {% endif -%}
        {% comment %} ============== Requester Practitioner Resource ============== {% endcomment -%}
            {% if requesterNM1.Elements[2].Value == "1" -%}
        {
            "fullUrl": "urn:uuid:{{ requesterPractId }}",
            "resource": {
                "resourceType": "Practitioner",
                "id": "{{ requesterPractId }}",
                {% if requesterNM1.Elements[9].Value != "" -%}
                "identifier": [
                    {
                        {% if requesterNM1.Elements[8].Value == "XV" -%}
                        "type": {
                            "coding": [
                                {
                                    "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                                    "code": "NPI"
                                }
                            ]
                        },
                        "system": "http://hl7.org/fhir/sid/us-npi",
                        {% endif -%}
                        "value": "{{ requesterNM1.Elements[9].Value }}"
                    }
                ],
                {% endif -%}
                "name": [
                    {
                        "family": "{{ requesterNM1.Elements[3].Value }}",
                        "given": [
                            "{{ requesterNM1.Elements[4].Value }}"
                            {% if requesterNM1.Elements[5].Value != "" -%}
                            ,"{{ requesterNM1.Elements[5].Value }}"
                            {% endif -%}
                        ]
                    }
                ]
            },
            "request": {
                "method": "PUT",
                "url": "Practitioner/{{ requesterPractId }}"
            }
        },
            {% endif -%}
        {% endif -%}
        {% comment %} ============== Service Provider Practitioner Resource ============== {% endcomment -%}
        {% if serviceProviderNM1 -%}
        {
            "fullUrl": "urn:uuid:{{ serviceProviderPractId }}",
            "resource": {
                {% if serviceProviderNM1.Elements[2].Value == "1" -%}
                "resourceType": "Practitioner",
                "id": "{{ serviceProviderPractId }}",
                {% if serviceProviderNM1.Elements[9].Value != "" -%}
                "identifier": [
                    {
                        {% if serviceProviderNM1.Elements[8].Value == "XV" -%}
                        "type": {
                            "coding": [
                                {
                                    "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                                    "code": "NPI"
                                }
                            ]
                        },
                        "system": "http://hl7.org/fhir/sid/us-npi",
                        {% endif -%}
                        "value": "{{ serviceProviderNM1.Elements[9].Value }}"
                    }
                ],
                {% endif -%}
                "name": [
                    {
                        "family": "{{ serviceProviderNM1.Elements[3].Value }}",
                        "given": [
                            "{{ serviceProviderNM1.Elements[4].Value }}"
                            {% if serviceProviderNM1.Elements[5].Value != "" -%}
                            ,"{{ serviceProviderNM1.Elements[5].Value }}"
                            {% endif -%}
                        ]
                    }
                ]
                {% else -%}
                "resourceType": "Organization",
                "id": "{{ serviceProviderPractId }}",
                {% if serviceProviderNM1.Elements[9].Value != "" -%}
                "identifier": [
                    {
                        {% if serviceProviderNM1.Elements[8].Value == "XV" -%}
                        "type": {
                            "coding": [
                                {
                                    "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                                    "code": "NPI"
                                }
                            ]
                        },
                        "system": "http://hl7.org/fhir/sid/us-npi",
                        {% endif -%}
                        "value": "{{ serviceProviderNM1.Elements[9].Value }}"
                    }
                ],
                {% endif -%}
                "name": "{{ serviceProviderNM1.Elements[3].Value }}"
                {% endif -%}
            },
            "request": {
                "method": "PUT",
                {% if serviceProviderNM1.Elements[2].Value == "1" -%}
                "url": "Practitioner/{{ serviceProviderPractId }}"
                {% else -%}
                "url": "Organization/{{ serviceProviderPractId }}"
                {% endif -%}
            }
        },
        {% endif -%}
        {% comment %} ============== Coverage Resource ============== {% endcomment -%}
        {% if subscriberNM1 -%}
        {
            "fullUrl": "urn:uuid:{{ coverageId }}",
            "resource": {
                "resourceType": "Coverage",
                "id": "{{ coverageId }}",
                "status": "active",
                {% if subscriberNM1.Elements[9].Value != "" -%}
                "subscriberId": "{{ subscriberNM1.Elements[9].Value }}",
                {% endif -%}
                "beneficiary": {
                    "reference": "Patient/{{ patientId }}"
                },
                {% if isDependent -%}
                "relationship": {
                    "coding": [
                        {
                            "system": "http://terminology.hl7.org/CodeSystem/subscriber-relationship",
                            "code": "other"
                        }
                    ]
                },
                {% else -%}
                "relationship": {
                    "coding": [
                        {
                            "system": "http://terminology.hl7.org/CodeSystem/subscriber-relationship",
                            "code": "self"
                        }
                    ]
                },
                {% endif -%}
                {% if umoNM1 -%}
                "payor": [
                    {
                        "reference": "Organization/{{ umoOrgId }}"
                    }
                ],
                {% endif -%}
                "subscriber": {
                    {% if isDependent -%}
                        {% assign subscriberPatIdInput = subscriberNM1.Value | prepend: "Patient_Subscriber_278_" -%}
                        {% assign subscriberPatId = subscriberPatIdInput | generate_uuid -%}
                        "reference": "Patient/{{ subscriberPatId }}"
                    {% else -%}
                        "reference": "Patient/{{ patientId }}"
                    {% endif -%}
                }
            },
            "request": {
                "method": "PUT",
                "url": "Coverage/{{ coverageId }}"
            }
        },
        {% endif -%}
        {% comment %} ============== Subscriber Patient (if dependent exists) ============== {% endcomment -%}
        {% if isDependent and subscriberNM1 -%}
            {% assign subscriberPatIdInput = subscriberNM1.Value | prepend: "Patient_Subscriber_278_" -%}
            {% assign subscriberPatId = subscriberPatIdInput | generate_uuid -%}
        {
            "fullUrl": "urn:uuid:{{ subscriberPatId }}",
            "resource": {
                "resourceType": "Patient",
                "id": "{{ subscriberPatId }}",
                {% if subscriberNM1.Elements[9].Value != "" -%}
                "identifier": [
                    {
                        {% if subscriberNM1.Elements[8].Value == "MI" -%}
                        "type": {
                            "coding": [
                                {
                                    "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
                                    "code": "MB",
                                    "display": "Member Number"
                                }
                            ]
                        },
                        {% endif -%}
                        "value": "{{ subscriberNM1.Elements[9].Value }}"
                    }
                ],
                {% endif -%}
                "name": [
                    {
                        "use": "official",
                        "family": "{{ subscriberNM1.Elements[3].Value }}",
                        "given": [
                            "{{ subscriberNM1.Elements[4].Value }}"
                        ]
                    }
                ]
            },
            "request": {
                "method": "PUT",
                "url": "Patient/{{ subscriberPatId }}"
            }
        },
        {% endif -%}
        {% comment %} ============== Condition Resources (from HI segments) ============== {% endcomment -%}
        {% for hiSeg in allHI -%}
            {% comment %}
              HI elements contain composite values with sub-elements.
              HI01 sub-elements: qualifier:code (e.g., ABK:J06.9)
