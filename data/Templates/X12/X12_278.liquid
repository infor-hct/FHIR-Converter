                        {% assign svcEndDate = svcDateVal | slice: 9, 8 -%}
                        {% assign svcSYear = svcStartDate | slice: 0, 4 -%}
                        {% assign svcSMonth = svcStartDate | slice: 4, 2 -%}
                        {% assign svcSDay = svcStartDate | slice: 6, 2 -%}
                        {% assign svcEYear = svcEndDate | slice: 0, 4 -%}
                        {% assign svcEMonth = svcEndDate | slice: 4, 2 -%}
                        {% assign svcEDay = svcEndDate | slice: 6, 2 -%}
                ,"occurrencePeriod": {
                    "start": "{{ svcSYear }}-{{ svcSMonth }}-{{ svcSDay }}",
                    "end": "{{ svcEYear }}-{{ svcEMonth }}-{{ svcEDay }}"
